S3_ACCESS_KEY=sentinel_dev
S3_SECRET_KEY=dev_password_change_me
S3_BUCKET=screensentinel-evidence

# ─── Dashboard ───
DASHBOARD_PORT=3000
API_BASE_URL=http://localhost:3001

# ─── ML ───
MODEL_DIR=./models
USE_GPU=false
