{
  "name": "screensentinel",
  "version": "1.0.0",
  "private": true,
  "description": "Invisible Forensic Attribution for Web Applications",
  "author": "Agent Viscro",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:migrate": "cd packages/extraction-api && alembic upgrade head",
